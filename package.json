{
  "name": "garage-authorizer-node",
  "version": "1.0.1",
  "description": "Sends command to open garage door based on result of http get",
  "exports": "./garage-authorizer.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./garage-authorizer.js",
    "dev": "LOG_LEVEL=debug node ./garage-authorizer.js | npx pino-pretty",
    "test": "node --test",
    "docker:build": "./scripts/docker/build.sh",
    "docker:up": "./scripts/docker/up.sh",
    "docker:down": "./scripts/docker/down.sh",
    "docker:logs": "./scripts/docker/logs.sh",
    "prepare": "husky"
  },
  "type": "module",
  "author": "Warren Volz <warren@warrenvolz.com>",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "csv": "^6.3.6",
    "form-data": "^4.0.1",
    "got": "^14.2.0",
    "memory-cache": "^0.2.0",
    "mqtt": "^5.3.5",
    "pino": "^8.19.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.2.5",
    "standard": "^17.1.0"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write --ignore-unknown",
      "standard --fix"
    ]
  }
}

# Copy this file to .env.production and adjust values for your host.
# docker compose will load these values when passed via --env-file.

IMAGE_NAME=garage-authorizer-node
IMAGE_TAG=latest
CONTAINER_NAME=garage-authorizer

# Host TCP port mapped to container port 1337
LISTEN_PORT=1337

# App runtime logging
LOG_LEVEL=info
LOG_TIMESTAMP=false
